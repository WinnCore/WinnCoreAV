[workspace]
resolver = "2"
members = [
    "av-core",
    "av-cli", 
    "av-daemon",
    "av-quarantine",
    "av-signatures",
]

[workspace.dependencies]
anyhow = "1.0"
async-trait = "0.1"
base64 = "0.21"
bloom = "0.3"
bytes = "1.10"
chrono = { version = "0.4", features = ["serde"] }
clap = { version = "4.5", features = ["derive"] }
config = "0.14"
dirs = "5.0"
ed25519-dalek = "2.1"
env_logger = "0.11"
goblin = "0.8"
hex = "0.4"
indicatif = "0.17"
landlock = "0.4"
libc = "0.2"
log = "0.4"
nix = { version = "0.29", features = ["fs"] }
notify = "6.1"
parking_lot = "0.12"
rand = "0.8"
rayon = "1.10"
regex = "1.11"
reqwest = { version = "0.12", features = ["blocking", "json"] }
ring = "0.17"
seccomp = "0.1"
semver = { version = "1.0", features = ["serde"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_with = { version = "3.11", features = ["hex"] }
sha2 = "0.10"
thiserror = "2.0"
tokio = { version = "1.42", features = ["full"] }
toml = "0.8"
tracing = "0.1"
tracing-subscriber = { version = "0.3.18", features = ["fmt", "env-filter"] }
url = "2.5"
walkdir = "2.5"
[workspace.dependencies]
# ... other deps ...
yara = { version = "0.23.0", default-features = false, features = ["vendored"] }
# ... other deps ...

[features]
# Our code that tweaks YARA config is behind this flag
yara_cfg_api = []
default = ["yara_cfg_api"]

[workspace.package]
edition = "2021"
version = "0.1.0"
authors = ["WinnCore"]
license = "MIT"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
