{
  "rules": [
    {
      "id": "exec_base64_decode",
      "name": "Base64 Encoded Command Execution",
      "technique": "T1059.004",
      "tactic": "Execution",
      "severity": "high",
      "description": "Detects execution of base64-decoded commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "base64 -d",
          "base64 --decode",
          "base64 -D"
        ]
      }
    },
    {
      "id": "exec_reverse_shell",
      "name": "Reverse Shell Pattern",
      "technique": "T1059.004",
      "tactic": "Execution",
      "severity": "critical",
      "description": "Detects reverse shell patterns in commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "/dev/tcp/",
          "/dev/udp/",
          "nc -e /bin",
          "ncat -e /bin",
          "bash -i >& /dev/tcp",
          "bash -i >&",
          "sh -i >&",
          "exec 5<>/dev/tcp"
        ]
      }
    },
    {
      "id": "exec_python_net",
      "name": "Python Network/Shell Execution",
      "technique": "T1059.006",
      "tactic": "Execution",
      "severity": "medium",
      "description": "Detects Python with network or shell modules",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "python.*import socket",
          "python.*import subprocess",
          "python.*from socket",
          "python.*from subprocess"
        ]
      }
    },
    {
      "id": "persist_crontab",
      "name": "Crontab Modification",
      "technique": "T1053.003",
      "tactic": "Persistence",
      "severity": "medium",
      "description": "Detects crontab command usage",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "crontab -e",
          "crontab -l",
          "crontab -r",
          "echo .* >> /etc/cron",
          "/var/spool/cron"
        ]
      }
    },
    {
      "id": "persist_bashrc",
      "name": "Shell Config Modification",
      "technique": "T1546.004",
      "tactic": "Persistence",
      "severity": "medium",
      "description": "Detects modifications to shell config files",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          ">> ~/.bashrc",
          ">> ~/.bash_profile",
          ">> ~/.profile",
          ">> ~/.zshrc",
          "echo .* >> ~/\\.bashrc"
        ]
      }
    },
    {
      "id": "persist_systemd",
      "name": "Systemd Service Creation",
      "technique": "T1543.002",
      "tactic": "Persistence",
      "severity": "high",
      "description": "Detects systemd service file creation",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "systemctl enable",
          "systemctl daemon-reload",
          "/etc/systemd/system/.*\\.service",
          "ExecStart=/",
          "cat .* > .*\\.service"
        ]
      }
    },
    {
      "id": "evasion_history_clear",
      "name": "History Clearing",
      "technique": "T1070.003",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects command history clearing",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "history -c",
          "history -w",
          "unset HISTFILE",
          "HISTSIZE=0",
          "rm .*\\.bash_history",
          "truncate .* ~/.bash_history"
        ]
      }
    },
    {
      "id": "evasion_timestomp",
      "name": "Timestomp",
      "technique": "T1070.006",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects timestamp modification",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "touch -t ",
          "touch -d ",
          "touch --date="
        ]
      }
    },
    {
      "id": "evasion_shm_exec",
      "name": "Execution from /dev/shm",
      "technique": "T1620",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects execution from tmpfs",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "/dev/shm/[a-zA-Z]",
          "/run/shm/[a-zA-Z]",
          "memfd_create",
          "memfd://"
        ]
      }
    },
    {
      "id": "evasion_masquerade",
      "name": "Process Masquerading",
      "technique": "T1036.005",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects process name masquerading",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "exec -a '\\[",
          "exec -a \"\\[",
          "exec -a \\[kworker",
          "prctl\\(PR_SET_NAME"
        ]
      }
    },
    {
      "id": "cred_shadow",
      "name": "Shadow File Access",
      "technique": "T1003.008",
      "tactic": "Credential Access",
      "severity": "critical",
      "description": "Detects access to /etc/shadow",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "cat /etc/shadow",
          "less /etc/shadow",
          "head /etc/shadow",
          "tail /etc/shadow",
          "cp /etc/shadow"
        ]
      }
    },
    {
      "id": "cred_ssh_key",
      "name": "SSH Key Access",
      "technique": "T1552.004",
      "tactic": "Credential Access",
      "severity": "high",
      "description": "Detects SSH private key access",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "cat .*id_rsa",
          "cat .*id_ed25519",
          "cat .*id_ecdsa",
          "cp .*\\.ssh/",
          "scp .*id_rsa"
        ]
      }
    },
    {
      "id": "cred_password_grep",
      "name": "Credential Search",
      "technique": "T1552.001",
      "tactic": "Credential Access",
      "severity": "medium",
      "description": "Detects searching for passwords",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "grep -r.*password",
          "grep -ri.*password",
          "grep.*PASSWORD",
          "find .* -name .*password"
        ]
      }
    },
    {
      "id": "cred_aws",
      "name": "AWS Credentials Access",
      "technique": "T1552.001",
      "tactic": "Credential Access",
      "severity": "high",
      "description": "Detects AWS credentials access",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "cat .*\\.aws/credentials",
          "cp .*\\.aws/credentials",
          "AWS_SECRET_ACCESS_KEY"
        ]
      }
    },
    {
      "id": "discovery_users",
      "name": "User Enumeration",
      "technique": "T1087.001",
      "tactic": "Discovery",
      "severity": "low",
      "description": "Detects user enumeration",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "cat /etc/passwd",
          "getent passwd",
          "cut -d: -f1 /etc/passwd"
        ]
      }
    },
    {
      "id": "discovery_network",
      "name": "Network Enumeration",
      "technique": "T1049",
      "tactic": "Discovery",
      "severity": "low",
      "description": "Detects network enumeration",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "ss -tunapl",
          "ss -tulpn",
          "netstat -tunapl",
          "netstat -tulpn"
        ]
      }
    },
    {
      "id": "discovery_security",
      "name": "Security Software Discovery",
      "technique": "T1518.001",
      "tactic": "Discovery",
      "severity": "medium",
      "description": "Detects security software discovery",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "ps.*clamav",
          "ps.*falcon",
          "systemctl.*crowdstrike",
          "pgrep -f.*defender"
        ]
      }
    },
    {
      "id": "c2_beacon",
      "name": "HTTP Beacon",
      "technique": "T1071.001",
      "tactic": "Command and Control",
      "severity": "medium",
      "description": "Detects HTTP beaconing patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "curl -s http",
          "curl --silent http",
          "wget -q http",
          "curl -s --max-time"
        ]
      }
    },
    {
      "id": "c2_download_exec",
      "name": "Download and Execute",
      "technique": "T1105",
      "tactic": "Command and Control",
      "severity": "critical",
      "description": "Detects download and execute patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "curl.*\\| sh",
          "curl.*\\| bash",
          "wget.*\\| sh",
          "wget.*\\| bash",
          "wget -O - http.*\\|",
          "curl -sSf.*\\|"
        ]
      }
    },
    {
      "id": "impact_ransom",
      "name": "Ransomware Pattern",
      "technique": "T1486",
      "tactic": "Impact",
      "severity": "critical",
      "description": "Detects ransomware patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "files encrypted",
          "send btc to",
          "\\.locked$",
          "\\.encrypted$",
          "decrypt.*key",
          "YOUR_FILES_ARE"
        ]
      }
    },
    {
      "id": "impact_destroy",
      "name": "Data Destruction",
      "technique": "T1485",
      "tactic": "Impact",
      "severity": "critical",
      "description": "Detects data destruction patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "rm -rf /(?:\\s|$|['\"])",
          "rm -rf /[^h]",
          "rm -rf /*",
          "dd if=/dev/zero of=/dev/sd",
          "shred -f",
          "mkfs\\..* /dev/sd"
        ]
      }
    },
    {
      "id": "privesc_container_escape",
      "name": "Container Escape via Docker Socket",
      "technique": "T1611",
      "tactic": "Privilege Escalation",
      "severity": "medium",
      "description": "Detects access to docker socket for potential container escape",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "/var/run/docker\\.sock",
          "/run/docker\\.sock",
          "curl.*docker\\.sock",
          "docker -H unix:///var/run/docker.sock",
          "mount.*docker\\.sock"
        ]
      }
    },
    {
      "id": "evasion_io_uring",
      "name": "io_uring Inspection",
      "technique": "T1014.io_uring",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects io_uring inspection which may indicate stealthy I/O hooks",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "io_uring",
          "io_uring_setup",
          "io_uring_enter"
        ]
      }
    },
    {
      "id": "obf_hex_encoding",
      "name": "Hex Encoded Command",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects hex encoded shell commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "echo -e '\\\\x[0-9a-fA-F]",
          "echo -e \"\\\\x[0-9a-fA-F]",
          "printf '\\\\x[0-9a-fA-F]",
          "printf \"\\\\x[0-9a-fA-F]",
          "\\$'\\\\x[0-9a-fA-F]",
          "\\\\x[0-9a-fA-F]{2}\\\\x[0-9a-fA-F]{2}"
        ]
      }
    },
    {
      "id": "obf_octal_encoding",
      "name": "Octal Encoded Command",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects octal encoded shell commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\$'\\\\[0-7]{3}",
          "echo -e '\\\\[0-7]{3}"
        ]
      }
    },
    {
      "id": "obf_rot13",
      "name": "ROT13 Encoding",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects ROT13 encoding in commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "tr 'A-Za-z' 'N-ZA-Mn-za-m'",
          "tr a-zA-Z n-za-mN-ZA-M",
          "tr \"a-zA-Z\" \"n-za-mN-ZA-M\"",
          "tr \"A-Za-z\" \"N-ZA-Mn-za-m\""
        ]
      }
    },
    {
      "id": "obf_reverse",
      "name": "Reverse String",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects reverse string obfuscation",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\| rev \\|",
          "\\| rev\\| ",
          "\\|rev \\|"
        ]
      }
    },
    {
      "id": "obf_env_slice",
      "name": "Env Variable Slicing",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects environment variable slicing for evasion",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\$\\{PATH:0:1\\}",
          "\\$\\{HOME:0:",
          "\\$\\{PWD:0:",
          "\\$\\{SHELL:0:"
        ]
      }
    },
    {
      "id": "obf_double_base64",
      "name": "Double Base64 Encoding",
      "technique": "T1027.001",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects double base64 encoding used to evade detection",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "base64 -d.*base64 -d",
          "base64 --decode.*base64"
        ]
      }
    },
    {
      "id": "obf_string_concat",
      "name": "String Concatenation Evasion",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects variable concatenation to build commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\$a\\$b",
          "\\$\\{a\\}\\$\\{b\\}"
        ]
      }
    },
    {
      "id": "obf_brace_expansion",
      "name": "Brace Expansion Evasion",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Detects brace expansion to construct commands",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\{e,c,h,o\\}",
          "\\{c,a,t\\}",
          "\\{w,h,o,a,m,i\\}"
        ]
      }
    },
    {
      "id": "obf_ifs_manipulation",
      "name": "IFS Manipulation",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects IFS variable manipulation for evasion",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "IFS=.*;"
        ]
      }
    },
    {
      "id": "obf_backtick_sub",
      "name": "Backtick Command Substitution",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "low",
      "description": "Detects nested backtick command substitution",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "`echo.*`",
          "`cat.*`"
        ]
      }
    },
    {
      "id": "obf_unicode_homoglyph",
      "name": "Unicode Homoglyph",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects potential unicode homoglyph attacks",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "\\\\u00[0-9a-fA-F]{2}",
          "printf.*\\\\u"
        ]
      }
    },
    {
      "id": "obf_xor_decode",
      "name": "XOR Decode Pattern",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects XOR decoding patterns often used in malware",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "python.*xor",
          "perl.*xor",
          "ruby.*xor"
        ]
      }
    },
    {
      "id": "heur_high_entropy_cmd",
      "name": "High Entropy Command",
      "technique": "T1027",
      "tactic": "Defense Evasion",
      "severity": "medium",
      "description": "Long command with potential encoded payload",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "[A-Za-z0-9+=]{50,}"
        ]
      }
    },
    {
      "id": "heur_webshell_spawn",
      "name": "Web Server Shell Spawn",
      "technique": "T1505.003",
      "tactic": "Persistence",
      "severity": "critical",
      "description": "Web server process spawning shell - possible webshell",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "php.*shell_exec",
          "php -r.*system\\(",
          "php -r.*passthru\\(",
          "php -r.*exec\\("
        ]
      }
    },
    {
      "id": "heur_script_download_exec",
      "name": "Download and Execute Script",
      "technique": "T1105",
      "tactic": "Command and Control",
      "severity": "critical",
      "description": "Downloading and immediately executing script",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "curl http.*\\| bash",
          "curl http.*\\| sh",
          "wget http.*\\| bash",
          "wget http.*\\| sh",
          "bash -c.*curl",
          "sh -c.*wget"
        ]
      }
    },
    {
      "id": "heur_memory_exec",
      "name": "Memory-Only Execution",
      "technique": "T1055",
      "tactic": "Defense Evasion",
      "severity": "critical",
      "description": "Fileless execution from memory",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "/dev/shm/[a-z]",
          "/run/shm/[a-z]",
          "memfd:",
          "/proc/self/fd/",
          "bash <\\(curl",
          "bash <\\(wget"
        ]
      }
    },
    {
      "id": "heur_proc_injection",
      "name": "Process Injection Indicators",
      "technique": "T1055",
      "tactic": "Defense Evasion",
      "severity": "critical",
      "description": "Detects ptrace and process injection attempts",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "LD_PRELOAD=/",
          "LD_PRELOAD=\\./",
          "ptrace\\(PTRACE_ATTACH"
        ]
      }
    },
    {
      "id": "heur_data_exfil",
      "name": "Data Exfiltration Pattern",
      "technique": "T1041",
      "tactic": "Exfiltration",
      "severity": "high",
      "description": "Detects data exfiltration patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "tar.*\\| curl",
          "tar.*\\| nc ",
          "cat.*\\| curl.*-X POST",
          "zip.*\\| curl"
        ]
      }
    },
    {
      "id": "heur_dns_tunnel",
      "name": "DNS Tunneling",
      "technique": "T1071.004",
      "tactic": "Command and Control",
      "severity": "high",
      "description": "Detects potential DNS tunneling",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "dig.*\\+short.*TXT",
          "dig.*TXT.*\\+short",
          "nslookup.*-type=TXT"
        ]
      }
    },
    {
      "id": "heur_crypto_miner",
      "name": "Cryptocurrency Miner",
      "technique": "T1496",
      "tactic": "Impact",
      "severity": "high",
      "description": "Detects cryptocurrency mining activity",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "xmrig",
          "stratum\\+tcp://",
          "stratum\\+ssl://",
          "minerd"
        ]
      }
    },
    {
      "id": "heur_rootkit_indicators",
      "name": "Rootkit Indicators",
      "technique": "T1014",
      "tactic": "Defense Evasion",
      "severity": "critical",
      "description": "Detects rootkit installation patterns",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "insmod /",
          "insmod \\./",
          "\\.ko$"
        ]
      }
    },
    {
      "id": "heur_log_tampering",
      "name": "Log Tampering",
      "technique": "T1070.002",
      "tactic": "Defense Evasion",
      "severity": "high",
      "description": "Detects log file tampering",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "> /var/log/",
          "truncate.*/var/log/",
          "rm.*/var/log/"
        ]
      }
    },
    {
      "id": "resp_active_ransomware",
      "name": "Active Ransomware Behavior",
      "technique": "T1486",
      "tactic": "Impact",
      "severity": "critical",
      "description": "Active ransomware encryption detected - immediate response required",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "openssl enc -aes",
          "YOUR_FILES_ARE_ENCRYPTED"
        ]
      }
    },
    {
      "id": "resp_wiper_malware",
      "name": "Wiper Malware",
      "technique": "T1485",
      "tactic": "Impact",
      "severity": "critical",
      "description": "Destructive wiper activity detected",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "dd if=/dev/zero of=/dev/sd",
          "dd if=/dev/urandom of=/dev/sd"
        ]
      }
    },
    {
      "id": "resp_credential_dump",
      "name": "Credential Dumping",
      "technique": "T1003",
      "tactic": "Credential Access",
      "severity": "critical",
      "description": "Active credential harvesting detected",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "mimipenguin",
          "lazagne",
          "linux-exploit-suggester"
        ]
      }
    },
    {
      "id": "resp_reverse_shell_active",
      "name": "Active Reverse Shell",
      "technique": "T1059",
      "tactic": "Execution",
      "severity": "critical",
      "description": "Active reverse shell connection",
      "condition": {
        "type": "process",
        "cmdline_contains_any": [
          "bash -i >& /dev/tcp",
          "bash -i >&/dev/tcp",
          "nc.*-e /bin/sh",
          "ncat.*-e /bin/bash"
        ]
      }
    },
    {
      "id": "resp_backdoor_install",
      "name": "Backdoor Installation",
      "technique": "T1543",
