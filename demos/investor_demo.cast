[12.030689, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;37m\u001b[1m\u001b[4mTECHNICAL ARCHITECTURE\u001b[0m\r\n\r\n\u001b[0;36m\u001b[1mSystem Architecture Overview:\u001b[0m\r\n\r\n"]
[12.032011, "o", "    ┌─────────────────────────────────────────────────────────────────┐\r\n    │                      USER SPACE                                 │\r\n    │  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐         │\r\n    │  │   CLI Tool   │  │  Dashboard   │  │   REST API   │         │\r\n    │  │   (winncore) │  │  (planned)   │  │   (planned)  │         │\r\n    │  └──────┬───────┘  └──────┬───────┘  └──────┬───────┘         │\r\n    │         └──────────────────┴──────────────────┘                 │\r\n    │                            │                                     │\r\n    │         ┌──────────────────▼───────────────────┐                │\r\n    │         │    WinnCoreAV Daemon (Rust)          │                │\r\n    │         │  ┌─────────────────────────────────┐ │                │\r\n    │         │  │  YARA-X Signature Engine        │ │                │\r\n    │         │  │  • Custom ARM64 detection rules │ │                │\r\n    │         │  └─────────────────────────────────┘ │                │\r\n    │         │  ┌─────────────────────────────────┐ │                │\r\n    │         │  │  ML Detection Engine (ONNX)     │ │                │\r\n    │         │  │  • LightGBM model (26 features) │ │                │\r\n    │         │  │  • Trained on synthetic samples │ │                │\r\n    │         │  └─────────────────────────────────┘ │                │\r\n    │         │  ┌─────────────────────────────────┐ │                │\r\n    │         │  │  Quarantine System              │ │                │\r\n    │         │  │  • SHA-512 verification         │ │                │\r\n    │         │  │  • Encrypted storage            │ │                │\r\n    │         │  └─────────────────────────────────┘ │                │\r\n    │         └──────────────────┬───────────────────┘                │\r\n    └────────────────────────────┼────────────────────────────────────┘\r\n                                 │\r\n    ┌────────────────────────────▼────────────────────────────────────┐\r\n    │                      KERNEL SPACE                               │\r\n    │  ┌──────────────────────────────────────────────────────────┐  │\r\n    │  │  eBPF Behavioral Analysis Engine                         │  │\r\n    │  │  • Syscall monitoring (execve, open, connect, etc.)     │  │\r\n    │  │  • Real-time process tracking                            │  │\r\n    │  │  • Zero kernel module dependencies                      │  │\r\n    │  └──"]
[12.032247, "o", "────────────────────────────────────────────────────────┘  │\r\n    │  ┌──────────────────────────────────────────────────────────┐  │\r\n    │  │  Fanotify File System Monitor                            │  │\r\n    │  │  • On-access scanning                                    │  │\r\n    │  │  • Pre-execution validation                              │  │\r\n    │  └──────────────────────────────────────────────────────────┘  │\r\n    │                                                                  │\r\n    │  ┌──────────────────────────────────────────────────────────┐  │\r\n    │  │  ARM64 Hardware Acceleration                             │  │\r\n    │  │  • NEON SIMD for parallel operations                     │  │\r\n    │  │  • Crypto Extensions for hash acceleration               │  │\r\n    │  │  • Measured: 400+ MB/s SHA-512 throughput                │  │\r\n    │  └──────────────────────────────────────────────────────────┘  │\r\n    └──────────────────────────────────────────────────────────────────┘\r\n\r\n"]
[15.033748, "o", "\u001b[0;36m\u001b[1mCore Technology Stack:\u001b[0m\r\n\r\n"]
[15.034012, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1mRust 1.75+ (Memory Safety)\u001b[0m\r\n    \u001b[2m|Zero CVEs, guaranteed thread safety\u001b[0m\r\n"]
[15.536415, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1mYARA-X (Signature Matching)\u001b[0m\r\n    \u001b[2m|Native Rust, better ARM64 support\u001b[0m\r\n"]
[16.038836, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1meBPF/libbpf (Behavioral)\u001b[0m\r\n    \u001b[2m|Kernel-level monitoring, no modules\u001b[0m\r\n"]
[16.541522, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1mONNX Runtime (ML Inference)\u001b[0m\r\n    \u001b[2m|Cross-platform, hardware-accelerated\u001b[0m\r\n"]
[17.044143, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1mFanotify (File Monitoring)\u001b[0m\r\n    \u001b[2m|Linux kernel API, real-time scanning\u001b[0m\r\n"]
[17.548202, "o", "  \u001b[0;32m▸\u001b[0m \u001b[1;37m\u001b[1mSHA-512 w/ ARM Crypto Ext\u001b[0m\r\n    \u001b[2m|Measured 400+ MB/s on Snapdragon X Elite\u001b[0m\r\n"]
[18.051074, "o", "\r\n"]
[19.054714, "o", "\u001b[1;33m\u001b[1mCurrent Limitations (Being Honest):\u001b[0m\r\n  \u001b[0;31m!\u001b[0m Dashboard is not yet built - CLI only\r\n  \u001b[0;31m!\u001b[0m No production deployments yet\r\n  \u001b[0;31m!\u001b[0m Detection models trained on synthetic malware only\r\n  \u001b[0;31m!\u001b[0m Solo developer - need team for scale\r\n  \u001b[0;31m!\u001b[0m No formal security certifications yet\r\n\r\n"]
