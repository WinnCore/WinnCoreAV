{
  "dashboard": {
    "title": "WinnCore AV - LOTL Defense Dashboard",
    "tags": ["winncore", "security", "lotl"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Total LOTL Detections",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(winncore_lotl_detections_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 10,
                  "color": "yellow"
                },
                {
                  "value": 50,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Total Automated Responses",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(winncore_responses_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 5,
                  "color": "yellow"
                },
                {
                  "value": 20,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Total Scans",
        "type": "stat",
        "targets": [
          {
            "expr": "winncore_scans_total",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Threats Mitigated",
        "type": "stat",
        "targets": [
          {
            "expr": "winncore_threats_mitigated_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Detections by Type (Last 1h)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(winncore_lotl_detections_total[5m])",
            "legendFormat": "{{type}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Detections/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 6,
        "title": "Responses by Action (Last 1h)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(winncore_responses_total[5m])",
            "legendFormat": "{{action}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Responses/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 7,
        "title": "Detection Types Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "winncore_lotl_detections_total",
            "legendFormat": "{{type}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 0,
          "y": 18
        }
      },
      {
        "id": 8,
        "title": "Response Actions Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "winncore_responses_total",
            "legendFormat": "{{action}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 12,
          "y": 18
        }
      },
      {
        "id": 9,
        "title": "Detection Rate Trend (24h)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(winncore_lotl_detections_total[1h])",
            "legendFormat": "Detection Rate",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 28
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Detections/hour"
          },
          {
            "format": "short"
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
